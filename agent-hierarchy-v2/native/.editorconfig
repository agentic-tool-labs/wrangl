root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_namespace_match_folder = false

# naming: I-prefixed interfaces, PascalCase types and members, _camelCase private fields
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_prefixed.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_rule.members_pascal.severity = warning
dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.members.applicable_accessibilities = public, internal, protected, protected_internal

dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = underscore_camel
dotnet_naming_rule.private_fields_camel.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# var when the type is apparent; expression bodies allowed
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# the rules that guard the boundaries
dotnet_diagnostic.CA1852.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.CA1823.severity = warning
dotnet_diagnostic.CA1812.severity = warning

# CA1812 cannot see the DispatchProxy and registry-attribute uses in tests.
[tests/**.cs]
dotnet_diagnostic.CA1812.severity = none

# The stores design owns this file for now: DbPeerRecords() goes with that work.
[src/Ah.Hierarchy/Core/HierarchyCore.cs]
dotnet_diagnostic.IDE0052.severity = none

# The Rig's _db field holds the database open for the test's life; it is never read on purpose.
[tests/Ah.Hierarchy.Tests/StatusDeltaParityTests.cs]
dotnet_diagnostic.IDE0052.severity = none
