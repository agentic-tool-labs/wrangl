{
  "about": "Hand corrections to the generated manifest (tests/manifest-notes.md says why). classify.mjs applies them by suite name after the heuristic.",
  "corrections": {
    "test-codex-no-credentials": {
      "kind": "static",
      "covers": [
        "hooks/*.mjs",
        "native/**",
        "mod/**"
      ],
      "reads_source": true
    },
    "test-run-all": {
      "kind": "contract",
      "covers": [
        "tests/run-all.sh",
        "tests/lib-daemon-leak.sh"
      ]
    },
    "test-run-all-lanes": {
      "kind": "contract",
      "covers": [
        "tests/run-all.sh",
        "tests/contract-tools/select.mjs",
        "tests/contract-tools/classify.mjs",
        "tests/manifest.json"
      ]
    },
    "test-ahd-team-hold": {
      "kind": "contract",
      "covers": [
        "bin/ah-hook",
        "native/src/Ah.Commands/Roster/Team/**"
      ]
    },
    "test-so-autonomy": {
      "kind": "static",
      "covers": [
        "native/src/Ah.Commands/Roster/**",
        "native/src/Ah.Roster/**"
