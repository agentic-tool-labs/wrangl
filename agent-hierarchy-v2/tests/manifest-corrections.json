    "test-contracts-s0": {
      "kind": "contract",
      "covers": [
        "hooks/*.mjs",
        "hooks/registry.json",
        "bin/ahd",
        "tests/contract-tools/**",
        "tests/contracts/**"
      ],
      "units": "all"
    },
    "test-contracts-s1": {
      "kind": "contract",
      "covers": [
        "hooks/*.mjs",
        "hooks/registry.json",
        "bin/ahd",
        "tests/contract-tools/**",
        "tests/contracts/**"
      ],
      "units": "all"
    },
    "test-contracts-s2": {
      "kind": "contract",
      "covers": [
