#!/bin/sh
d=$(dirname "$0")/..
echo "$*" >> "$d/git.log"
case "$*" in
  *'rev-parse --show-toplevel') printf '%s\n' "$2"; exit 0;;
  *'symbolic-ref -q refs/remotes/origin/HEAD') printf '%s' 'refs/remotes/origin/main
'; exit 0;;
  *'rev-parse --verify -q refs/remotes/origin/main^{commit}') exit 0;;
  *) exit 1;;
esac
