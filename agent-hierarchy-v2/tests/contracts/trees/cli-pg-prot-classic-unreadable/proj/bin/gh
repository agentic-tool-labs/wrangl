#!/bin/sh
d=$(dirname "$0")/..
echo "$*" >> "$d/gh.log"
case "$*" in
  'api repos/{owner}/{repo}/branches/main') printf '%s' '{"protected":true}'; exit 0;;
  'api repos/{owner}/{repo}/rules/branches/main') printf '%s' '[]'; exit 0;;
  'api repos/{owner}/{repo}/branches/main/protection') printf '%s' 'gh: Not Found (HTTP 404)
second line' >&2; exit 1;;
  *) exit 1;;
esac
