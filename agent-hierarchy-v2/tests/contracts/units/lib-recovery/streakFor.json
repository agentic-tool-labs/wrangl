          }
        ],
        "s",
        1780315200000
      ],
      "expect": 1
    },
    {
      "id": "missing-ts",
      "args": [
        [
          {
            "type": "watch-event",
            "kind": "RESUME",
            "subject": "s"
          }
        ],
        "s",
        1780315200000
      ],
      "expect": 1
    },
    {
      "id": "non-object-rows-skipped",
      "args": [
        [
          null,
          "x",
          5,
          [],
          {
            "type": "watch-event",
            "kind": "RESUME",
            "subject": "s",
            "ts": "2026-06-01T11:59:59.000Z"
          }
        ],
        "s",
        1780315200000
      ],
      "expect": 2
    },
    {
      "id": "numeric-subject-is-strict",
      "args": [
        [
          {
            "type": "watch-event",
            "kind": "RESUME",
            "subject": 5,
            "ts": "2026-06-01T11:59:59.000Z"
          }
        ],
        "5",
        1780315200000
      ],
      "expect": 1
    },
    {
      "id": "subject-undefined-matches-missing-subject",
      "args": [
        [
          {
            "type": "watch-event",
            "kind": "RESUME",
            "ts": "2026-06-01T11:59:59.000Z"
          }
        ],
        {
          "$undefined": 1
        },
        1780315200000
      ],
      "expect": 2
    },
    {
      "id": "failed-at-nan-counts-everything",
      "args": [
        [
          {
            "type": "watch-event",
            "kind": "RESUME",
            "subject": "s",
            "ts": "2026-06-01T08:15:00.000Z"
          }
        ],
        "s",
        {
          "$nan": 1
        }
      ],
      "expect": 2
    }
  ]
}
