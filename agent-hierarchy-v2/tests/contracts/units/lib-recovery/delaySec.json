{
  "lib": "lib-recovery",
  "module": "hooks/lib-recovery.mjs",
  "fn": "delaySec",
  "cases": [
    {
      "id": "rate-limit-1",
      "args": [
        "rate_limit",
        1
      ],
      "expect": 120
    },
    {
      "id": "rate-limit-2",
      "args": [
        "rate_limit",
        2
      ],
      "expect": 480
    },
    {
      "id": "rate-limit-3",
      "args": [
        "rate_limit",
        3
      ],
      "expect": 1200
    },
    {
      "id": "rate-limit-4-clamps",
      "args": [
        "rate_limit",
        4
      ],
      "expect": 1200
    },
    {
      "id": "rate-limit-huge-clamps",
      "args": [
        "rate_limit",
        1000000
      ],
      "expect": 1200
    },
    {
      "id": "rate-limit-infinity-clamps",
      "args": [
        "rate_limit",
        {
          "$inf": 1
        }
      ],
      "expect": 1200
