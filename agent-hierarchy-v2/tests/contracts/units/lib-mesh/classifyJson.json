{
  "lib": "lib-mesh",
  "module": "tests/contract-tools/units-shims/lib-mesh.mjs",
  "fn": "classifyJson",
  "cases": [
    {
      "id": "orchestrator",
      "args": [
        {
          "address": "orchestrator@tm",
          "teams": {
            "tm": {
              "data": {
                "members": [
                  {
                    "name": "a",
                    "role": "implementor"
                  },
                  {
                    "name": "b",
                    "role": "reviewer"
                  },
                  {
                    "name": "c",
                    "role": "architect"
                  }
                ]
              },
              "dir": "$ROOT/h"
            },
            "ot": {
              "data": {
                "members": [
                  {
                    "name": "x",
                    "role": "implementor"
                  }
                ]
              },
              "dir": "$ROOT/h2"
            }
          }
        }
      ],
      "expect": {
        "kind": "orchestrator",
        "address": "orchestrator@tm",
        "name": "orchestrator",
        "team": "tm",
        "role": "orchestrator"
      }
    },
