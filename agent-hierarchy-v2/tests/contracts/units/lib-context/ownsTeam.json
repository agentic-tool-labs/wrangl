    {
      "id": "by-session",
      "rerecorded": "peer-proof #144: a team is owned only by its recorded Orchestrator's pid with its recorded start time; this fixture records no start (or owns by session id alone), so the invoker owns nothing",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[],\"orchestrator\":{\"pid\":100,\"session_id\":\"sA\"}}",
        "repo/.claude/hierarchy/teams/beta.json": "{\"members\":[],\"orchestrator\":{\"pid\":200,\"session_id\":\"sB\"}}"
      },
      "expect": false
    },
