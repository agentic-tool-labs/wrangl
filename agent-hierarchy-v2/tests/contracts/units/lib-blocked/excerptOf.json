{
  "lib": "lib-blocked",
  "module": "hooks/lib-blocked.mjs",
  "fn": "excerptOf",
  "cases": [
    {
      "id": "plain-lines",
      "args": [
        "one\ntwo\nthree"
      ],
      "expect": "one\ntwo\nthree"
    },
    {
      "id": "trailing-space-trimmed-and-blank-lines-dropped",
      "args": [
        "a  \n\n   \nb\t\n"
      ],
      "expect": "a\nb"
    },
    {
      "id": "only-last-twelve-lines",
      "args": [
        "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15\nline 16\nline 17\nline 18\nline 19\nline 20"
      ],
      "expect": "line 9\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15\nline 16\nline 17\nline 18\nline 19\nline 20"
    },
    {
      "id": "exactly-twelve-lines",
      "args": [
        "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12"
      ],
      "expect": "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12"
    },
    {
      "id": "csi-sequences-stripped",
      "args": [
        "\u001b[31mred\u001b[0m and \u001b[1;32mgreen\u001b[0m"
      ],
      "expect": "red and green"
    },
    {
      "id": "osc-sequences-stripped-bel-terminated",
      "args": [
        "\u001b]0;window title\u0007text after"
      ],
      "expect": "text after"
    },
    {
      "id": "osc-sequences-stripped-st-terminated",
      "args": [
        "\u001b]8;;http://x\u001b\\link\u001b]8;;\u001b\\"
      ],
      "expect": "link"
    },
    {
      "id": "two-byte-escape-stripped",
      "args": [
        "\u001b=keypad \u001b>numeric"
      ],
      "expect": "=keypad >numeric"
    },
    {
      "id": "carriage-returns-removed",
      "args": [
        "a\r\nb\r\n"
      ],
      "expect": "a\nb"
    },
    {
      "id": "control-characters-removed",
      "args": [
        "a\u0001b\bc\u000bd\fe\u001ffghi"
      ],
      "expect": "abcdefghi"
    },
    {
      "id": "tab-and-newline-survive-control-strip",
      "args": [
        "a\tb\nc"
      ],
      "expect": "a\tb\nc"
    },
    {
      "id": "note-replaces-screen",
      "args": [
        "screen text",
        "the heading"
      ],
      "expect": "the heading"
    },
    {
      "id": "note-is-cleaned-and-trimmed",
      "args": [
        "screen text",
        "  \u001b[1mHeading\u001b[0m  "
      ],
      "expect": "Heading"
    },
    {
      "id": "note-that-cleans-to-empty-falls-back-to-screen",
      "args": [
        "screen text",
        "\u001b[0m"
      ],
      "expect": "screen text"
    },
    {
      "id": "whitespace-only-note-gives-empty-text",
      "args": [
        "screen text",
        "   "
      ],
      "expect": ""
    },
    {
      "id": "empty-note-falls-back-to-screen",
      "args": [
        "screen text",
        ""
      ],
      "expect": "screen text"
    },
    {
      "id": "null-note-falls-back-to-screen",
      "args": [
        "screen text",
        null
      ],
      "expect": "screen text"
    },
    {
      "id": "capped-at-1200",
      "args": [
        ""
      ],
      "expect": ""
    },
    {
      "id": "exactly-1200-kept",
      "args": [
        ""
      ],
      "expect": ""
    },
    {
      "id": "capped-multi-line",
      "args": [
        "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
      ],
      "expect": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
    },
    {
      "id": "null-screen",
      "args": [
        null
      ],
      "expect": ""
    },
    {
      "id": "undefined-screen",
      "args": [
        {
          "$undefined": 1
        }
      ],
      "expect": ""
    },
    {
      "id": "number-screen-is-stringified",
      "args": [
        12345
      ],
      "expect": "12345"
    },
    {
      "id": "empty-screen",
      "args": [
        ""
      ],
      "expect": ""
    },
    {
      "id": "unicode-kept",
      "args": [
        "héllo ✓ 日本語"
      ],
      "expect": "héllo ✓ 日本語"
    }
  ]
}
