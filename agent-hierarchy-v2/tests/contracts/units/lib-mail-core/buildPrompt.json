{
  "lib": "lib-mail-core",
  "module": "hooks/lib-mail-core.mjs",
  "fn": "buildPrompt",
  "cases": [
    {
      "id": "one-group-all-kinds",
      "args": [
        [
          {
            "address": "tm-implementor@tm",
            "entries": [
              {
                "v": 1,
                "id": "a1",
                "from": "orchestrator@tm",
                "kind": "brief",
                "route": "pull",
                "ref": "/m/a1--request.md",
                "created": "2026-01-01T11:59:59.000Z"
              },
              {
                "v": 1,
                "id": "b2",
                "from": "tm-reviewer@tm",
                "kind": "report",
                "route": "pull",
                "ref": "/m/b2--response.md",
                "created": "2026-01-01T11:59:59.000Z"
              },
              {
                "v": 1,
                "id": "c3",
                "from": "user",
                "kind": "note",
                "route": "pull",
                "ref": {
                  "$undefined": 1
                },
                "created": "2026-01-01T11:59:59.000Z",
                "text": "two\nlines"
              },
              {
                "v": 1,
                "id": "d4",
                "from": "ahd",
                "kind": "event",
                "route": "pull",
                "ref": {
                  "$undefined": 1
                },
                "created": "2026-01-01T11:59:59.000Z",
                "event": "check-in-due",
                "text": "tm-x is silent"
              }
            ]
          }
        ]
      ],
      "expect": "ah mail for tm-implementor@tm (4):\n- brief from orchestrator@tm: [hierarchy-msg /m/a1--request.md]\n  Reply when done: msg.mjs send orchestrator@tm --ref <your response path>\n- report from tm-reviewer@tm: [hierarchy-msg /m/b2--response.md]\n- note from user: two\nlines\n- event check-in-due: tm-x is silent\n[ah-entry a1,b2,c3,d4]"
    },
    {
      "id": "two-groups",
      "args": [
        [
          {
            "address": "o@a",
            "entries": [
              {
                "v": 1,
                "id": "a1",
                "from": "orchestrator@tm",
                "kind": "brief",
                "route": "pull",
                "ref": "/m/a1--request.md",
                "created": "2026-01-01T11:59:59.000Z"
