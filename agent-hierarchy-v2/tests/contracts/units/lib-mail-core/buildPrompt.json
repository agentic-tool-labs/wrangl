            "address": "o@b",
            "entries": [
              {
                "v": 1,
                "id": "b1",
                "from": "orchestrator@tm",
                "kind": "brief",
                "route": "pull",
                "ref": "/m/b1--request.md",
                "created": "2026-01-01T11:59:59.000Z"
              },
              {
                "v": 1,
                "id": "b2",
                "from": "user",
                "kind": "note",
                "route": "pull",
                "ref": {
                  "$undefined": 1
                },
                "created": "2026-01-01T11:59:59.000Z",
                "text": "hi"
              }
            ]
          }
        ]
