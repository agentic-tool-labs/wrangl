    },
    {
      "id": "no-groups",
      "args": [
        []
      ],
      "expect": ""
    },
    {
      "id": "group-without-entries",
      "args": [
        [
          {
            "address": "o@a",
            "entries": []
          }
        ]
      ],
      "expect": "ah mail for o@a (0):\n[ah-entry ]"
