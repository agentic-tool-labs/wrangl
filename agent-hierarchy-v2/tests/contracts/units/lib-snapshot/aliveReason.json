{
  "lib": "lib-snapshot",
  "module": "hooks/lib-snapshot.mjs",
  "fn": "aliveReason",
  "cases": [
    {
      "id": "no-session-id",
      "args": [
        null
      ],
      "files": {},
      "env": {
        "AH_HOME": "$ROOT/ah",
        "PATH": "$ROOT/bin:/usr/bin:/bin",
        "TZ": "UTC"
      },
      "expect": null
    },
    {
      "id": "empty-session-id",
      "args": [
        ""
      ],
      "files": {},
      "env": {
        "AH_HOME": "$ROOT/ah",
        "PATH": "$ROOT/bin:/usr/bin:/bin",
        "TZ": "UTC"
      },
      "expect": null
    },
    {
      "id": "registration-with-live-pid-started-before-write",
      "args": [
        "sess-aaaa1111"
      ],
      "files": {
        "ah/registrations/sess-aaaa1111.json": "{\"v\":1,\"harness\":\"claude\",\"session_id\":\"sess-aaaa1111\",\"address\":\"p-x@proj\",\"addresses\":[\"p-x@proj\"],\"at\":\"2026-10-01T10:00:00.000Z\",\"pid\":1}\n",
        "bin/ps": {
          "text": "#!/bin/sh\ncase \"$*\" in\n  *lstart*) printf '%s\\n' 'Wed Sep 30 09:00:00 2026' ;;\n  *) cat \"$0.out\" ;;\nesac\n",
          "mode": 493
        },
        "bin/ps.out": ""
      },
      "env": {
        "AH_HOME": "$ROOT/ah",
        "PATH": "$ROOT/bin:/usr/bin:/bin",
        "TZ": "UTC"
      },
      "expect": "registration pid 1"
    },
    {
      "id": "registration-pid-started-after-write-is-a-reused-pid",
      "args": [
        "sess-aaaa1111"
      ],
      "files": {
        "ah/registrations/sess-aaaa1111.json": "{\"v\":1,\"harness\":\"claude\",\"session_id\":\"sess-aaaa1111\",\"address\":\"p-x@proj\",\"addresses\":[\"p-x@proj\"],\"at\":\"2026-10-01T10:00:00.000Z\",\"pid\":1}\n",
        "bin/ps": {
          "text": "#!/bin/sh\ncase \"$*\" in\n  *lstart*) printf '%s\\n' 'Mon Dec 31 23:00:00 2035' ;;\n  *) cat \"$0.out\" ;;\nesac\n",
          "mode": 493
        },
        "bin/ps.out": ""
      },
      "env": {
        "AH_HOME": "$ROOT/ah",
        "PATH": "$ROOT/bin:/usr/bin:/bin",
        "TZ": "UTC"
      },
      "expect": null
    },
    {
      "id": "registration-pid-started-within-slack",
      "args": [
        "sess-aaaa1111"
      ],
      "files": {
        "ah/registrations/sess-aaaa1111.json": "{\"v\":1,\"harness\":\"claude\",\"session_id\":\"sess-aaaa1111\",\"address\":\"p-x@proj\",\"addresses\":[\"p-x@proj\"],\"at\":\"2026-10-01T10:00:00.000Z\",\"pid\":1}\n",
        "bin/ps": {
          "text": "#!/bin/sh\ncase \"$*\" in\n  *lstart*) printf '%s\\n' 'Wed Sep 30 09:00:00 2026' ;;\n  *) cat \"$0.out\" ;;\nesac\n",
          "mode": 493
        },
        "bin/ps.out": "claude --resume sess-aaaa1111\n"
      },
      "env": {
        "AH_HOME": "$ROOT/ah",
        "PATH": "$ROOT/bin:/usr/bin:/bin",
        "TZ": "UTC"
      },
      "expect": "registration pid 1"
    },
    {
      "id": "registration-dead-pid-then-claude-process",
      "args": [
        "sess-bbbb2222"
      ],
      "files": {
        "ah/registrations/sess-bbbb2222.json": "{\"v\":1,\"harness\":\"claude\",\"session_id\":\"sess-bbbb2222\",\"address\":\"p-x@proj\",\"addresses\":[\"p-x@proj\"],\"at\":\"2026-10-01T10:00:00.000Z\",\"pid\":999999}\n",
        "bin/ps": {
          "text": "#!/bin/sh\ncase \"$*\" in\n  *lstart*) printf '%s\\n' 'Wed Sep 30 09:00:00 2026' ;;\n  *) cat \"$0.out\" ;;\nesac\n",
          "mode": 493
