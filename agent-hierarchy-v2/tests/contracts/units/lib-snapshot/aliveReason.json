      "id": "lstart-unparseable-counts-as-registrant",
      "args": [
        "sess-gggg7777"
      ],
      "files": {
        "ah/registrations/sess-gggg7777.json": "{\"v\":1,\"harness\":\"claude\",\"session_id\":\"sess-gggg7777\",\"address\":\"p-x@proj\",\"addresses\":[\"p-x@proj\"],\"at\":\"2026-10-01T10:00:00.000Z\",\"pid\":1}\n",
        "bin/ps": {
          "text": "#!/bin/sh\ncase \"$*\" in\n  *lstart*) printf '%s\\n' 'not a date' ;;\n  *) cat \"$0.out\" ;;\nesac\n",
