{
  "lib": "lib-status",
  "module": "hooks/lib-status.mjs",
  "fn": "readActivity",
  "cases": [
    {
      "id": "record",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": {
        "activity": "working",
        "at": "2026-06-01T11:58:20.000Z",
        "blocked_by": null,
        "note": null,
        "tool": null,
        "tool_at": null
      }
    },
    {
      "id": "missing-file",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "gone.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": null
    },
    {
      "id": "no-activity-dir",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": null
    },
    {
      "id": "slash-in-name",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "../team.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": null
    },
    {
      "id": "backslash-in-name",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "a\\b.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": null
    },
    {
      "id": "activity-is-a-file",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity": "x"
      },
      "expect": null
    },
    {
      "id": "activity-dir-is-a-link-to-another-dir",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "elsewhere/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}"
      },
      "links": {
        "repo/.claude/hierarchy/activity": "$ROOT/elsewhere"
      },
      "expect": null
    },
    {
      "id": "record-file-is-a-link",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "elsewhere/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}"
      },
      "links": {
        "repo/.claude/hierarchy/activity/sA.json": "$ROOT/elsewhere/sA.json"
      },
      "expect": null
    },
    {
      "id": "empty-file",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": ""
      },
      "expect": null
    },
    {
      "id": "invalid-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{nope"
      },
      "expect": null
    },
    {
      "id": "array-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "[1]"
      },
      "expect": null
    },
    {
      "id": "scalar-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "5"
      },
      "expect": null
    },
    {
      "id": "null-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "null"
      },
      "expect": null
    },
    {
      "id": "exactly-at-the-size-cap",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null,\"pad\":\"\"}"
      },
      "expect": {
        "activity": "working",
        "at": "2026-06-01T11:58:20.000Z",
        "blocked_by": null,
        "note": null,
        "tool": null,
        "tool_at": null,
        "pad": ""
      }
    },
    {
      "id": "one-byte-over-the-size-cap",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null,\"pad\":\"\"}"
      },
      "expect": null
    },
    {
      "id": "a-directory-named-like-a-record",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "d.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/d.json/.keep": ""
      },
      "expect": null
    },
    {
      "id": "dir-missing",
      "args": [
        "$ROOT/nowhere",
        "sA.json"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": null
    }
  ]
}
