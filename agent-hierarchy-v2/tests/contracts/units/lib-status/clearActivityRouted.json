{
  "lib": "lib-status",
  "module": "hooks/lib-status.mjs",
  "fn": "clearActivityRouted",
  "cases": [
    {
      "id": "removes",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": null
      },
      "expect": {
        "$undefined": 1
      }
    },
    {
      "id": "nothing-to-remove",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "sA"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/.keep": ""
      },
      "expect": {
        "$undefined": 1
      }
    },
    {
      "id": "no-dir",
      "args": [
        {
          "$undefined": 1
        },
        "sA"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": {
        "$undefined": 1
      }
    },
    {
      "id": "dir-missing",
      "args": [
        "$ROOT/nowhere",
        "sA"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "$undefined": 1
      }
    },
    {
      "id": "invalid-subject",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        ""
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": {
        "$undefined": 1
      }
    }
  ]
}
