{
  "lib": "lib-status",
  "module": "hooks/lib-status.mjs",
  "fn": "activityAfterWrite",
  "cases": [
    {
      "id": "record-that-wrote-refreshes",
      "args": [
        "record",
        {
          "dir": "$ROOT/repo/.claude/hierarchy",
          "subject": "sA"
        },
        {
          "written": true
        },
        null,
        {}
      ],
      "now": "2026-06-01T12:00:00Z",
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/.keep": ""
      },
      "expectFiles": {
        "repo/.claude/hierarchy/status.json": {
          "$json": {
            "schema": 1,
            "written_at": "$any",
            "expires_at": "$any",
            "enabled": true,
            "member_sessions": [],
            "teams": [],
            "timeline": [
              {
                "at": "$any",
                "visible": false,
                "tone": "idle",
                "live": 0,
                "out": 0,
                "blocked": 0,
                "overdue": 0,
                "stalled": 0,
                "text": "0 live · 0 out",
                "short": "0/0"
              }
            ],
            "owners": []
          }
        }
      },
      "expect": {
        "$undefined": 1
      }
    },
