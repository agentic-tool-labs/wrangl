{
  "lib": "lib-status",
  "module": "hooks/lib-status.mjs",
  "fn": "sweepActivity",
  "cases": [
    {
      "id": "cutoff-before-everything-removes-none",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        0
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n",
        "repo/.claude/hierarchy/activity/sB.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 0
    },
    {
      "id": "cutoff-after-everything-removes-all",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n",
        "repo/.claude/hierarchy/activity/sB.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": null,
        "repo/.claude/hierarchy/activity/sB.json": null
      },
      "expect": 2
    },
    {
      "id": "mid-cutoff-removes-the-old",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        1775001600000
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n",
        "repo/.claude/hierarchy/activity/sB.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "mtimes": {
        "repo/.claude/hierarchy/activity/sA.json": "2026-01-01T00:00:00Z",
        "repo/.claude/hierarchy/activity/sB.json": "2026-05-01T00:00:00Z"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": null,
        "repo/.claude/hierarchy/activity/sB.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 1
    },
    {
      "id": "mtime-equal-to-cutoff-is-kept",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        1767225600000
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "mtimes": {
        "repo/.claude/hierarchy/activity/sA.json": "2026-01-01T00:00:00Z"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 0
    },
    {
      "id": "mtime-just-before-cutoff-is-removed",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        1767225600001
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "mtimes": {
        "repo/.claude/hierarchy/activity/sA.json": "2026-01-01T00:00:00Z"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": null
      },
      "expect": 1
    },
    {
      "id": "non-json-files-skipped",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n",
        "repo/.claude/hierarchy/activity/sA.json.123.tmp": "x",
        "repo/.claude/hierarchy/activity/notes.txt": "x"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json.123.tmp": "x",
        "repo/.claude/hierarchy/activity/notes.txt": "x",
        "repo/.claude/hierarchy/activity/sA.json": null
      },
      "expect": 1
    },
    {
      "id": "directory-named-like-a-record-is-skipped-in-the-count",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n",
        "repo/.claude/hierarchy/activity/d.json/.keep": ""
      },
      "expect": 1
    },
    {
      "id": "no-activity-dir",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": 0
    },
    {
      "id": "dir-missing",
      "args": [
        "$ROOT/nowhere",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": 0
    },
    {
      "id": "activity-dir-is-a-link",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        99999999999999
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "elsewhere/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}"
      },
      "links": {
        "repo/.claude/hierarchy/activity": "$ROOT/elsewhere"
      },
      "expectFiles": {
        "elsewhere/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}"
      },
      "expect": 0
    },
    {
      "id": "cutoff-undefined-removes-none",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        {
          "$undefined": 1
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 0
    },
    {
      "id": "cutoff-null-is-zero",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        null
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 0
    },
    {
      "id": "cutoff-numeric-string-coerces",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "99999999999999"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": null
      },
      "expect": 1
    },
    {
      "id": "cutoff-nan-removes-none",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        {
          "$nan": 1
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expectFiles": {
        "repo/.claude/hierarchy/activity/sA.json": "{\"activity\":\"working\",\"at\":\"2026-06-01T11:58:20.000Z\",\"blocked_by\":null,\"note\":null,\"tool\":null,\"tool_at\":null}\n"
      },
      "expect": 0
    }
  ]
}
