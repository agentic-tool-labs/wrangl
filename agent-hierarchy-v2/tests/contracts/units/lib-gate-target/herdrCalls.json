{
  "lib": "lib-gate-target",
  "module": "hooks/lib-gate-target.mjs",
  "fn": "herdrCalls",
  "cases": [
    {
      "id": "agent-prompt",
      "args": [
        "herdr agent prompt p-implementor hello there",
        "agent",
        [
          "prompt",
          "send-keys",
          "attach"
        ]
      ],
      "expect": [
        {
          "group": "agent",
          "verb": "prompt",
          "name": "p-implementor",
          "pane": null,
          "args": [
            "hello",
            "there"
          ]
        }
      ]
    },
    {
      "id": "agent-send-keys-with-keys",
      "args": [
        "herdr agent send-keys p-implementor Enter",
        "agent",
        [
          "prompt",
          "send-keys",
          "attach"
        ]
      ],
      "expect": [
        {
          "group": "agent",
          "verb": "send-keys",
          "name": "p-implementor",
          "pane": null,
          "args": [
            "Enter"
          ]
        }
      ]
    },
