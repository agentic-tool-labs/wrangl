{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "teamMemberRenamedFrom",
  "cases": [
    {
      "id": "found",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "old-architect"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"route\":\"peer\",\"renamed_from\":\"old-architect\"},{\"role\":\"reviewer\",\"name\":\"p-reviewer\",\"route\":\"pane\"},{\"role\":\"task-runner\",\"name\":\"p-runner\",\"route\":\"subagent\"},{\"role\":\"architect\",\"name\":\"p-architect-2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "role": "architect",
        "name": "p-architect",
        "route": "peer",
        "renamed_from": "old-architect"
      }
    },
    {
      "id": "not-found",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "nobody"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"route\":\"peer\",\"renamed_from\":\"old-architect\"},{\"role\":\"reviewer\",\"name\":\"p-reviewer\",\"route\":\"pane\"},{\"role\":\"task-runner\",\"name\":\"p-runner\",\"route\":\"subagent\"},{\"role\":\"architect\",\"name\":\"p-architect-2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": null
    },
    {
      "id": "empty-name",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        ""
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"route\":\"peer\",\"renamed_from\":\"old-architect\"},{\"role\":\"reviewer\",\"name\":\"p-reviewer\",\"route\":\"pane\"},{\"role\":\"task-runner\",\"name\":\"p-runner\",\"route\":\"subagent\"},{\"role\":\"architect\",\"name\":\"p-architect-2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": null
    },
    {
      "id": "named-team",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "old",
        "alpha"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"a\",\"name\":\"n\",\"renamed_from\":\"old\"}]}"
      },
      "expect": {
        "role": "a",
        "name": "n",
        "renamed_from": "old"
      }
    },
    {
      "id": "no-team",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "x"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": null
    },
    {
      "id": "null-rows-skipped",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "old"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[null,5,{\"role\":\"a\",\"name\":\"n\",\"renamed_from\":\"old\"}]}"
      },
      "expect": {
        "role": "a",
        "name": "n",
        "renamed_from": "old"
      }
    }
  ]
}
