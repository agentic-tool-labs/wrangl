        "home/.codex/config.toml": "[projects.\"$ROOT/work/repo\"]\ntrust_level = \"trusted\"\n"
      },
      "expect": {
        "verdict": "trusted",
        "configPath": "$ROOT/home/.codex/config.toml",
        "codexHome": "$ROOT/home/.codex",
        "trustRoot": "$ROOT/work/repo"
      }
