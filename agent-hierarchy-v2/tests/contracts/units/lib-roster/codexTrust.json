        "work/repo/.git/HEAD": "ref: refs/heads/main\n",
        "work/repo/sub/x": ""
      },
      "expect": {
        "verdict": "unknown",
        "configPath": "$ROOT/home/.codex/config.toml",
        "codexHome": "$ROOT/home/.codex",
        "trustRoot": "$ROOT/work/repo"
      }
    },
