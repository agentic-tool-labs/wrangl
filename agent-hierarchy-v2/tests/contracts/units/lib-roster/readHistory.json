{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "readHistory",
  "cases": [
    {
      "id": "absent",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "version": 1,
        "teams": []
      }
    },
    {
      "id": "good",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team-history.json": "{\"version\":1,\"teams\":[{\"id\":\"id1\",\"fingerprint\":\"ab12cd34\",\"alias\":null,\"label\":\"default (1 role)\",\"created_at\":\"2026-01-01T00:00:00+00:00\",\"last_used\":\"2026-01-01T00:00:00+00:00\",\"last_team_id\":null,\"roster_level\":null,\"transport\":null,\"members\":[{\"role\":\"architect\"}]}]}"
      },
      "expect": {
        "version": 1,
        "teams": [
          {
            "id": "id1",
            "fingerprint": "ab12cd34",
            "alias": null,
            "label": "default (1 role)",
            "created_at": "2026-01-01T00:00:00+00:00",
            "last_used": "2026-01-01T00:00:00+00:00",
            "last_team_id": null,
            "roster_level": null,
            "transport": null,
            "members": [
              {
                "role": "architect"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "invalid-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team-history.json": "{x"
      },
      "expect": {
        "version": 1,
        "teams": []
      }
    },
    {
      "id": "teams-not-array",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team-history.json": "{\"version\":1,\"teams\":{}}"
      },
      "expect": {
        "version": 1,
        "teams": []
      }
    },
    {
      "id": "array-document",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team-history.json": "[]"
      },
      "expect": {
        "version": 1,
        "teams": []
      }
    },
    {
      "id": "extra-keys-kept",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team-history.json": "{\"version\":1,\"note\":\"x\",\"teams\":[]}"
      },
      "expect": {
        "version": 1,
        "note": "x",
        "teams": []
      }
    },
    {
      "id": "worktree-reads-home",
      "args": [
        "$ROOT/wt/.claude/hierarchy"
      ],
      "files": {
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n",
        "main/.claude/hierarchy/team-history.json": "{\"version\":1,\"teams\":[{\"id\":\"id1\",\"fingerprint\":\"ab12cd34\",\"alias\":null,\"label\":\"default (1 role)\",\"created_at\":\"2026-01-01T00:00:00+00:00\",\"last_used\":\"2026-01-01T00:00:00+00:00\",\"last_team_id\":null,\"roster_level\":null,\"transport\":null,\"members\":[{\"role\":\"architect\"}]}]}"
      },
      "expect": {
        "version": 1,
        "teams": [
          {
            "id": "id1",
            "fingerprint": "ab12cd34",
            "alias": null,
            "label": "default (1 role)",
            "created_at": "2026-01-01T00:00:00+00:00",
            "last_used": "2026-01-01T00:00:00+00:00",
            "last_team_id": null,
            "roster_level": null,
            "transport": null,
            "members": [
              {
                "role": "architect"
              }
            ]
          }
        ]
      }
    }
  ]
}
