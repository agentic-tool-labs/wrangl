{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "historyPath",
  "cases": [
    {
      "id": "plain",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "expect": "$ROOT/repo/.claude/hierarchy/team-history.json"
    },
    {
      "id": "worktree",
      "args": [
        "$ROOT/wt/.claude/hierarchy"
      ],
      "files": {
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n"
      },
      "expect": "$ROOT/main/.claude/hierarchy/team-history.json"
    }
  ]
}
