{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "teamFileState",
  "cases": [
    {
      "id": "usable-default",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "state": "usable",
        "path": "$ROOT/repo/.claude/hierarchy/team.json",
        "team": {
          "members": [
            {
              "role": "architect",
              "name": "p-architect",
              "transport_id": "%1",
              "route": "peer"
            }
          ],
          "orchestrator": {
            "pid": 1
          }
        }
      }
    },
    {
      "id": "usable-named",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "alpha"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "state": "usable",
        "path": "$ROOT/repo/.claude/hierarchy/teams/alpha.json",
        "team": {
          "members": [
            {
              "role": "architect",
              "name": "p-architect",
              "transport_id": "%1",
              "route": "peer"
            }
          ],
          "orchestrator": {
            "pid": 1
          }
        }
      }
    },
    {
      "id": "absent",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "state": "absent",
        "path": "$ROOT/repo/.claude/hierarchy/team.json",
        "team": null
      }
    },
    {
      "id": "unusable-not-json",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{x"
      },
      "expect": {
        "state": "unusable",
        "path": "$ROOT/repo/.claude/hierarchy/team.json",
        "team": null
      }
    },
    {
      "id": "unusable-no-members",
      "args": [
        "$ROOT/repo/.claude/hierarchy"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"orchestrator\":{}}"
      },
      "expect": {
        "state": "unusable",
        "path": "$ROOT/repo/.claude/hierarchy/team.json",
        "team": null
      }
    },
    {
      "id": "worktree-home-file",
      "args": [
        "$ROOT/wt/.claude/hierarchy",
        "alpha"
      ],
      "files": {
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n",
        "main/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "state": "usable",
        "path": "$ROOT/main/.claude/hierarchy/teams/alpha.json",
        "team": {
          "members": [
            {
              "role": "architect",
              "name": "p-architect",
              "transport_id": "%1",
              "route": "peer"
            }
          ],
          "orchestrator": {
            "pid": 1
          }
        }
      }
    }
  ]
}
