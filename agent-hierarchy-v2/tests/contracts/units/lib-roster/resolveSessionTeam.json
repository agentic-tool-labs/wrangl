    {
      "id": "default-team-first-then-named-ambiguous",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "reviewer"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"reviewer\",\"name\":\"a\",\"route\":\"peer\"}]}",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"reviewer\",\"name\":\"b\",\"route\":\"peer\"}]}"
      },
      "expect": null
    }
  ]
}
