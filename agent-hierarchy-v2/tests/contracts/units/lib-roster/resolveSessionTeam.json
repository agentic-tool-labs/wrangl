{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "resolveSessionTeam",
  "cases": [
    {
      "id": "explicit-existing",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "architect",
        "alpha"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"route\":\"peer\",\"renamed_from\":\"old-architect\"},{\"role\":\"reviewer\",\"name\":\"p-reviewer\",\"route\":\"pane\"},{\"role\":\"task-runner\",\"name\":\"p-runner\",\"route\":\"subagent\"},{\"role\":\"architect\",\"name\":\"p-architect-2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "teamName": "alpha",
        "team": {
          "members": [
            {
              "role": "architect",
              "name": "p-architect",
              "route": "peer",
              "renamed_from": "old-architect"
            },
            {
              "role": "reviewer",
              "name": "p-reviewer",
              "route": "pane"
            },
            {
              "role": "task-runner",
              "name": "p-runner",
              "route": "subagent"
            },
            {
              "role": "architect",
              "name": "p-architect-2",
              "route": "peer"
            }
          ],
          "orchestrator": {
            "pid": 1
          }
        }
      }
    },
    {
      "id": "explicit-missing",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "architect",
        "alpha"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": null
    },
    {
      "id": "one-candidate-one-member",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "reviewer"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"route\":\"peer\",\"renamed_from\":\"old-architect\"},{\"role\":\"reviewer\",\"name\":\"p-reviewer\",\"route\":\"pane\"},{\"role\":\"task-runner\",\"name\":\"p-runner\",\"route\":\"subagent\"},{\"role\":\"architect\",\"name\":\"p-architect-2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "teamName": null,
        "team": {
          "members": [
            {
              "role": "architect",
              "name": "p-architect",
              "route": "peer",
              "renamed_from": "old-architect"
            },
            {
              "role": "reviewer",
              "name": "p-reviewer",
              "route": "pane"
            },
            {
              "role": "task-runner",
              "name": "p-runner",
              "route": "subagent"
            },
            {
              "role": "architect",
              "name": "p-architect-2",
              "route": "peer"
            }
          ],
          "orchestrator": {
            "pid": 1
          }
        }
      }
    },
    {
      "id": "two-members-of-role-ambiguous",
      "args": [
        "$ROOT/repo/.claude/hierarchy",
        "architect"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
