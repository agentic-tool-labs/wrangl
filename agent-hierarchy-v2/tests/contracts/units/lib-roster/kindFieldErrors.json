    {
      "id": "kind-codex-autoMode-invalid",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "autoMode": "yolo"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-codex-args-ok",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "args": [
            "--search"
          ]
        }
      ],
      "expect": []
    },
    {
      "id": "kind-codex-args-not-array",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "args": "--search"
        }
      ],
      "expect": [
        "args must be an array of strings, got \"--search\""
      ]
    },
    {
      "id": "kind-codex-args-bad-element",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "args": [
            "--ok",
            "",
            5
          ]
        }
      ],
      "expect": [
        "args[1] must be a non-empty string, got \"\"",
        "args[2] must be a non-empty string, got 5"
      ]
    },
    {
      "id": "kind-codex-args-set-model-too",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "model": "gpt-5",
          "args": [
            "--model",
            "x"
          ]
        }
      ],
      "expect": [
        "model is set, and args sets the model too — one channel per setting: drop the model flag from args, or drop model (got [\"--model\",\"x\"])"
      ]
    },
    {
      "id": "kind-codex-args-model-without-model-field",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "args": [
            "--model",
            "x"
          ]
        }
      ],
      "expect": []
    },
    {
      "id": "kind-codex-args-approvals",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "args": [
            "-c",
            "approvals_reviewer=auto"
          ]
        }
      ],
      "expect": [
        "args must not set approvals_reviewer: every codex member is launched with -c approvals_reviewer=\"user\", so an escalation waits for a human, and a later setting in args would undo that (got [\"-c\",\"approvals_reviewer=auto\"])"
      ]
    },
    {
      "id": "kind-codex-args-on-advise",
      "args": [
        {
          "role": "ultra-advisor",
          "kind": "codex",
          "route": "pane",
          "args": [
            "--search"
          ]
        }
      ],
      "expect": [
        "args is not allowed on a non-claude advise-class member (ultra-advisor) — it could set a second model past the tier lock, or brief the member at launch without the user's approval (got [\"--search\"])"
      ]
    },
    {
      "id": "kind-codex-advise-no-args",
      "args": [
        {
          "role": "ultra-advisor",
          "kind": "codex",
          "route": "pane",
          "model": "gpt-5"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-claude-args-rejected",
      "args": [
        {
          "role": "architect",
          "args": [
            "--model",
            "haiku"
          ]
        }
      ],
      "expect": [
        "args is not allowed for kind \"claude\" — Claude CLI flags are set with --model/--effort/--auto-mode, which are validated; args would bypass that (got [\"--model\",\"haiku\"])"
      ]
    },
    {
      "id": "kind-claude-args-empty-ok",
      "args": [
        {
          "role": "architect",
          "args": []
        }
      ],
      "expect": []
    },
