      "id": "kind-claude-explicit-args",
      "args": [
        {
          "role": "architect",
          "kind": "claude",
          "args": [
            "x"
          ]
        }
      ],
      "expect": [
        "args is not allowed for kind \"claude\" — Claude CLI flags are set with --model/--effort/--auto-mode, which are validated; args would bypass that (got [\"x\"])"
      ]
    },
    {
      "id": "kind-other-model-no-mapping",
      "args": [
        {
          "role": "implementor",
          "kind": "gemini",
          "route": "pane",
          "model": "g1"
        }
      ],
      "expect": [
        "model has no mapping for kind \"gemini\" — pass that harness's own model flag in args instead (got \"g1\")"
      ]
    },
