    {
      "id": "kind-other-advise",
      "args": [
        {
          "role": "ultra-advisor",
          "kind": "gemini",
          "route": "pane"
        }
      ],
      "expect": [
        "The Ultra-Advisor's model must have a declared opus or fable tier, and `gemini` has no model mapping, so its model cannot be set or declared. Use claude, or a kind with a model mapping (codex)."
      ]
    },
    {
      "id": "kind-other-clean",
      "args": [
        {
          "role": "implementor",
          "kind": "gemini",
          "route": "pane"
        }
      ],
      "expect": []
    },
    {
      "id": "adapter-appserver-on-codex",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "adapter": "appserver"
        }
      ],
      "expect": []
    },
    {
      "id": "adapter-off-on-codex",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "adapter": "off"
        }
      ],
      "expect": []
    },
    {
      "id": "adapter-invalid",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "adapter": "yes"
        }
      ],
      "expect": [
        "adapter must be \"appserver\" or \"off\" (or removed), got \"yes\""
      ]
    },
    {
      "id": "adapter-on-claude",
      "args": [
        {
          "role": "architect",
          "adapter": "appserver"
        }
      ],
      "expect": [
        "adapter \"appserver\" applies only to kind codex, not \"claude\" — remove it"
      ]
    },
    {
      "id": "adapter-on-other-kind",
      "args": [
        {
          "role": "implementor",
          "kind": "gemini",
          "route": "pane",
          "adapter": "off"
        }
      ],
      "expect": [
        "adapter \"off\" applies only to kind codex, not \"gemini\" — remove it"
      ]
    },
    {
      "id": "kind-custom-rejected-in-roster",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-custom-no-harness",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail"
        }
