      "id": "kind-custom-builtin-harness",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "codex"
        }
      ],
      "expect": [
        "harness \"codex\" is built in and needs no admission — choose another name for a custom harness"
      ]
    },
    {
      "id": "kind-custom-bad-harness-name",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "A"
        }
      ],
      "expect": [
        "harness is required for kind \"custom\" and must match ^[a-z][a-z0-9-]{1,31}$, got \"A\""
      ]
    },
    {
      "id": "kind-custom-harness-name-too-long",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "expect": [
        "harness is required for kind \"custom\" and must match ^[a-z][a-z0-9-]{1,31}$, got \"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\""
      ]
    },
    {
      "id": "kind-custom-harness-name-max",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-custom-wrong-route",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "pane",
          "harness": "my-agent"
        }
      ],
      "expect": [
        "route must be \"mail\" for kind \"custom\", got \"pane\""
      ]
    },
    {
      "id": "kind-custom-command-multiline",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent",
          "command": "a\nb"
        }
      ],
      "expect": [
        "command must be a single-line non-empty string, got \"a\\nb\""
      ]
    },
    {
      "id": "kind-custom-command-blank",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent",
          "command": "  "
        }
      ],
      "expect": [
        "command must be a single-line non-empty string, got \"  \""
      ]
    },
    {
      "id": "kind-custom-command-ok",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent",
          "command": "run it"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-custom-command-nul",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent",
          "command": "a\u0000b"
        }
      ],
      "expect": [
        "command must be a single-line non-empty string, got \"a\\u0000b\""
      ]
    },
    {
      "id": "kind-custom-model-effort-args",
      "args": [
        {
          "role": "implementor",
          "kind": "custom",
          "route": "mail",
          "harness": "my-agent",
          "model": "x",
          "effort": "low",
          "autoMode": "auto",
          "args": [
            "x"
          ]
        }
      ],
      "expect": [
        "model has no meaning for kind \"custom\" — remove it (got \"x\")",
        "effort has no meaning for kind \"custom\" — remove it (got \"low\")",
        "auto-mode has no meaning for kind \"custom\" — remove it (got \"auto\")",
        "args has no meaning for kind \"custom\" — remove it (got [\"x\"])"
      ]
    }
  ]
}
