        {
          "role": "implementor",
          "kind": "gemini",
          "route": "pane",
          "autoMode": "auto"
        }
      ],
      "expect": [
        "auto-mode is a Claude Code CLI flag and has no meaning for kind \"gemini\" — remove it (got \"auto\")"
      ]
