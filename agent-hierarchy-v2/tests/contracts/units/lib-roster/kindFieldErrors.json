    {
      "id": "kind-codex-minimal",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-codex-no-route",
      "args": [
        {
          "role": "implementor",
          "kind": "codex"
        }
      ],
      "expect": [
        "route must be \"pane\" for kind \"codex\" (a non-claude agent is reached through its Herdr pane, not SendMessage or the Agent tool), got undefined"
      ]
    },
    {
      "id": "kind-codex-peer-route",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "peer"
        }
      ],
      "expect": [
        "route must be \"pane\" for kind \"codex\" (a non-claude agent is reached through its Herdr pane, not SendMessage or the Agent tool), got \"peer\""
      ]
    },
    {
      "id": "kind-codex-model-ok",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "model": "gpt-5"
        }
      ],
      "expect": []
    },
    {
      "id": "kind-codex-model-with-space",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "model": "gpt 5"
        }
      ],
      "expect": [
        "model must be a non-empty string with no whitespace or control characters, got \"gpt 5\""
      ]
    },
    {
      "id": "kind-codex-model-empty",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "model": ""
        }
      ],
      "expect": [
        "model must be a non-empty string with no whitespace or control characters, got \"\""
