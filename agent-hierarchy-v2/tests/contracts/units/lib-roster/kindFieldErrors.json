      ],
      "expect": [
        "effort is a Claude Code CLI flag and has no meaning for kind \"codex\" — remove it (got \"high\")"
      ]
    },
    {
      "id": "kind-codex-autoMode-mapped",
      "args": [
        {
          "role": "implementor",
          "kind": "codex",
          "route": "pane",
          "autoMode": "plan"
        }
      ],
      "expect": []
