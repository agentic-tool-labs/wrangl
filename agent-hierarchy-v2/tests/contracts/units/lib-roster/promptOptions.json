          },
          {
            "n": 2,
            "marked": false,
            "label": "Yes, and don't ask again for commands that start with `ls` (p)"
          },
          {
            "n": 3,
            "marked": false,
            "label": "No, and tell Codex what to do differently (esc)"
          }
        ],
        {
          "cwd": "/work/repo",
          "configPath": "/home/u/.codex/config.toml",
