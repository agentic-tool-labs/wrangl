    {
      "id": "context-placeholder-twice",
      "args": [
        "codex",
        "trust-dialog",
        [
          {
            "n": 2,
            "marked": true,
            "label": "No, quit"
          }
        ],
        {
          "cwd": "/a<b",
          "configPath": "/home/u/.codex/config.toml",
          "codexHome": "/home/u/.codex",
          "trustRoot": "/work/repo"
        }
