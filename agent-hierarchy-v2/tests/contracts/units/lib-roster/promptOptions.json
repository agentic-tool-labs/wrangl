      "expect": [
        {
          "id": "distrust",
          "label": "No, quit",
          "description": "Codex quits and saves nothing. The member doesn't start, and its pane is left at a shell. Nothing is written to `/home/u/.codex/config.toml`, so the next Codex launch in `/a<b` asks again.",
          "grants": false
        }
      ]
    }
  ]
