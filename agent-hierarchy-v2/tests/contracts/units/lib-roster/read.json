{
  "lib": "lib-roster",
  "module": "hooks/lib-roster.mjs",
  "fn": "read",
  "cases": [
    {
      "id": "by-path-record",
      "args": [
        {
          "path": "$ROOT/repo/.claude/hierarchy/teams/alpha.json"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "members": [
          {
            "role": "architect",
            "name": "p-architect",
            "transport_id": "%1",
            "route": "peer"
          }
        ],
        "orchestrator": {
          "pid": 1
        }
      }
    },
    {
      "id": "by-path-absent",
      "args": [
        {
          "path": "$ROOT/repo/.claude/hierarchy/teams/alpha.json"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": null
    },
    {
      "id": "by-path-not-a-record",
      "args": [
        {
          "path": "$ROOT/repo/.claude/hierarchy/teams/alpha.json"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/teams/alpha.json": "[1]"
      },
      "expect": null
    },
    {
      "id": "by-dir-default-then-named",
      "args": [
        {
          "dir": "$ROOT/repo/.claude/hierarchy"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}",
        "repo/.claude/hierarchy/teams/beta.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%3\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "teams": [
          {
            "name": null,
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%1",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          },
          {
            "name": "alpha",
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%3",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          },
          {
            "name": "beta",
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%2",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": "by-dir-skips-unreadable",
      "args": [
        {
          "dir": "$ROOT/repo/.claude/hierarchy"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/.claude/hierarchy/team.json": "{x",
        "repo/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%3\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "teams": [
          {
            "name": "alpha",
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%3",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": "by-dir-none",
      "args": [
        {
          "dir": "$ROOT/repo/.claude/hierarchy"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "teams": []
      }
    },
    {
      "id": "by-dir-worktree-home-and-pool",
      "args": [
        {
          "dir": "$ROOT/wt/.claude/hierarchy"
        }
      ],
      "files": {
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n",
        "main/.claude/hierarchy/team.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%1\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}",
        "wt/.claude/hierarchy/teams/alpha.json": "{\"members\":[{\"role\":\"architect\",\"name\":\"p-architect\",\"transport_id\":\"%2\",\"route\":\"peer\"}],\"orchestrator\":{\"pid\":1}}"
      },
      "expect": {
        "teams": [
          {
            "name": null,
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%1",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          },
          {
            "name": "alpha",
            "team": {
              "members": [
                {
                  "role": "architect",
                  "name": "p-architect",
                  "transport_id": "%2",
                  "route": "peer"
                }
              ],
              "orchestrator": {
                "pid": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": "neither-path-nor-dir-fails",
      "args": [
        {}
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expectThrows": true
    }
  ]
}
