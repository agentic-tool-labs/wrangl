    {
      "id": "none",
      "args": [
        "## [0] tldr\nDONE\n"
      ],
      "expect": null
    },
    {
      "id": "no-section",
      "args": [
        "BLOCKED"
      ],
      "expect": null
    },
    {
      "id": "empty",
      "args": [
        ""
      ],
      "expect": null
    },
    {
      "id": "undefined",
      "args": [
        {
          "$undefined": 1
        }
      ],
      "expect": null
    }
  ]
