{
  "lib": "lib-hier",
  "module": "hooks/lib-hier.mjs",
  "fn": "gatesPath",
  "cases": [
    {
      "id": "absolute",
      "args": [
        "/a/b"
      ],
      "expect": "/a/b/gates.jsonl"
    },
    {
      "id": "trailing-slash",
      "args": [
        "/a/b/"
      ],
      "expect": "/a/b/gates.jsonl"
    },
    {
      "id": "relative",
      "args": [
        "a"
      ],
      "expect": "a/gates.jsonl"
    },
    {
      "id": "dotdot-normalised",
      "args": [
        "/a/b/../c"
      ],
      "expect": "/a/c/gates.jsonl"
    }
  ]
}
