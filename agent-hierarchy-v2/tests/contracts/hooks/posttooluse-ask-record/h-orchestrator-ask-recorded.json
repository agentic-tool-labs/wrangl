{
  "kind": "hook",
  "id": "h-orchestrator-ask-recorded",
  "about": "the recorded Orchestrator's question and response are recorded as received",
  "tree": "hook-ask-orchestrator",
  "env": {
    "CLAUDE_PLUGIN_ROOT": "<PLUGIN>",
    "AH_DAEMON": "off"
  },
  "cwd": "<ROOT:proj>",
  "input": {
    "script": "posttooluse-ask-record",
    "event": {
      "hook_event_name": "PostToolUse",
      "session_id": "sess-contract",
      "cwd": "<ROOT:proj>",
      "transcript_path": "<ROOT:home>/.claude/projects/contract/sess-contract.jsonl",
      "tool_name": "AskUserQuestion",
      "tool_input": {
        "questions": [
          {
            "question": "Which?",
            "header": "h",
            "options": [
              {
                "label": "a",
                "description": "a"
              },
              {
                "label": "b",
                "description": "b"
              }
            ],
            "multiSelect": false
          }
        ]
      },
      "tool_response": {
        "answers": {
          "Which?": "a"
        }
      },
      "tool_use_id": "toolu_contract"
    }
  },
  "mutant": "an ask not recorded",
  "expect": {
    "stdout": "",
    "stderr": "",
    "exit": 0,
