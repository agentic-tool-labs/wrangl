{
  "_comment": "One row per input of the test-mode predicate (AH_TEST exactly 1 AND AH_HOME's real path under a user-owned, owner-only /tmp/ahprobe.<alnum> directory). Run by sh (bin/ah-testmode.sh, tests/test-home-predicate.sh) and by C# (Ah.Platform.Tests HomePredicateTableTests). cwd (optional) is the working directory the sh predicate runs in (the C# predicate refuses a relative path before touching the file system, so it ignores it); $ROOT is a fresh /tmp/ahprobe.XXXXXX at mode 0700, $OUT a fresh directory that is not under an ahprobe name, $RAND a fresh alphanumeric token. ops run in order before the predicate; every path under /tmp is removed afterwards.",
  "cases": [
    { "id": "valid-sandbox", "ah_test": "1", "ah_home": "$ROOT/ah", "expect": true },
    { "id": "valid-home-is-the-probe-itself", "ah_test": "1", "ah_home": "$ROOT", "expect": true },
    { "id": "valid-nested-nonexistent", "ah_test": "1", "ah_home": "$ROOT/a/b/c", "expect": true },
    { "id": "valid-existing-subdir", "ah_test": "1", "ah_home": "$ROOT/sub", "ops": [{ "op": "mkdir", "path": "$ROOT/sub" }], "expect": true },
    { "id": "valid-mode-0750", "ah_test": "1", "ah_home": "$ROOT/ah", "ops": [{ "op": "chmod", "path": "$ROOT", "mode": "0750" }], "expect": true },
    { "id": "valid-mode-0755", "ah_test": "1", "ah_home": "$ROOT/ah", "ops": [{ "op": "chmod", "path": "$ROOT", "mode": "0755" }], "expect": true },

    { "id": "ah-test-unset", "ah_test": null, "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-zero", "ah_test": "0", "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-true", "ah_test": "true", "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-eleven", "ah_test": "11", "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-leading-blank", "ah_test": " 1", "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-trailing-blank", "ah_test": "1 ", "ah_home": "$ROOT/ah", "expect": false },
    { "id": "ah-test-leading-zero", "ah_test": "01", "ah_home": "$ROOT/ah", "expect": false },

    { "id": "ah-home-unset", "ah_test": "1", "ah_home": null, "expect": false },
    { "id": "ah-home-empty", "ah_test": "1", "ah_home": "", "expect": false },
    { "id": "ah-home-relative", "ah_test": "1", "ah_home": "x/ah", "expect": false },
    { "id": "ah-home-relative-with-a-sandbox-tail", "ah_test": "1", "ah_home": "zz$ROOT/ah", "expect": false },
    { "id": "ah-home-outside", "ah_test": "1", "ah_home": "$OUT/ah", "expect": false },
    { "id": "ah-home-relative-that-exists-from-the-working-directory", "ah_test": "1", "ah_home": "ah", "cwd": "$ROOT", "ops": [{ "op": "mkdir", "path": "$ROOT/ah" }], "expect": false },

    { "id": "dotdot-in-the-remainder", "ah_test": "1", "ah_home": "$ROOT/a/../b", "expect": false },
    { "id": "trailing-dotdot-in-the-remainder", "ah_test": "1", "ah_home": "$ROOT/a/b/..", "expect": false },
    { "id": "empty-component-in-the-remainder", "ah_test": "1", "ah_home": "$ROOT/a//b", "expect": false },
    { "id": "trailing-slash-after-a-missing-component", "ah_test": "1", "ah_home": "$ROOT/a/", "expect": false },
    { "id": "dotdot-through-an-existing-directory-that-leaves", "ah_test": "1", "ah_home": "$ROOT/sub/../../outside", "ops": [{ "op": "mkdir", "path": "$ROOT/sub" }], "expect": false },

    { "id": "dangling-link-in-the-path", "ah_test": "1", "ah_home": "$ROOT/dangling/ah", "ops": [{ "op": "symlink", "path": "$ROOT/dangling", "target": "$OUT/not-there" }], "expect": false },
    { "id": "link-out-of-the-sandbox", "ah_test": "1", "ah_home": "$ROOT/out/ah", "ops": [{ "op": "symlink", "path": "$ROOT/out", "target": "$OUT" }], "expect": false },
    { "id": "probe-named-link-to-an-outside-directory", "ah_test": "1", "ah_home": "/tmp/ahprobe.l$RAND/ah", "ops": [{ "op": "symlink", "path": "/tmp/ahprobe.l$RAND", "target": "$OUT" }], "expect": false },

    { "id": "root-group-writable", "ah_test": "1", "ah_home": "$ROOT/ah", "ops": [{ "op": "chmod", "path": "$ROOT", "mode": "0770" }], "expect": false },
    { "id": "root-other-writable", "ah_test": "1", "ah_home": "$ROOT/ah", "ops": [{ "op": "chmod", "path": "$ROOT", "mode": "0707" }], "expect": false },
    { "id": "root-world-writable", "ah_test": "1", "ah_home": "$ROOT/ah", "ops": [{ "op": "chmod", "path": "$ROOT", "mode": "0777" }], "expect": false },

    { "id": "probe-name-without-a-suffix", "ah_test": "1", "ah_home": "/tmp/ahprobe./ah", "ops": [{ "op": "mkdir", "path": "/tmp/ahprobe." }], "expect": false },
    { "id": "probe-name-with-a-hyphen", "ah_test": "1", "ah_home": "/tmp/ahprobe.a-b/ah", "ops": [{ "op": "mkdir", "path": "/tmp/ahprobe.a-b" }], "expect": false },
    { "id": "probe-name-with-a-dot", "ah_test": "1", "ah_home": "/tmp/ahprobe.a.b/ah", "ops": [{ "op": "mkdir", "path": "/tmp/ahprobe.a.b" }], "expect": false },
    { "id": "probe-name-with-a-prefix", "ah_test": "1", "ah_home": "/tmp/xahprobe.$RAND/ah", "ops": [{ "op": "mkdir", "path": "/tmp/xahprobe.$RAND" }], "expect": false },
    { "id": "probe-named-file", "ah_test": "1", "ah_home": "/tmp/ahprobe.f$RAND/ah", "ops": [{ "op": "touch", "path": "/tmp/ahprobe.f$RAND" }], "expect": false },
    { "id": "probe-directory-not-directly-in-tmp", "ah_test": "1", "ah_home": "$OUT/ahprobe.abc123/ah", "ops": [{ "op": "mkdir", "path": "$OUT/ahprobe.abc123" }], "expect": false },
    { "id": "dotdot-after-a-file-component", "ah_test": "1", "ah_home": "$ROOT/afile/../ah", "ops": [{ "op": "touch", "path": "$ROOT/afile" }], "expect": false },
    { "id": "component-below-a-file", "ah_test": "1", "ah_home": "$ROOT/afile/ah", "ops": [{ "op": "touch", "path": "$ROOT/afile" }], "expect": true }
  ],
  "trusted_homes_comment": "One row per input of the state-home verdict (which AH_HOME a process may use outside test mode: the default home under the passwd home, or a directory listed in <default home>/trusted-homes under the trust-file validity rules; test mode accepts what it is given). Run by sh (bin/ah-trust.sh, tests/contract-tools/trusted-homes-sh.mjs) and by C# (Ah.Cli.Tests TrustedHomesTableTests, over the AhHomeGate pipeline and the trust store). $ROOT, $OUT and $RAND are as in cases; the passwd home is $ROOT/pw and its default home $ROOT/pw/.claude/ah2. ops add write {path, content, pad_to?}: pad_to fills the file with comment-free filler lines to that many bytes. expect.home is the resolved home (the tokens are compared by their real paths); expect.test_mode marks a row accepted because test mode holds. cwd (optional) is the working directory of the sh verdict only: the C# verdict reads a relative line as ignored before it touches the file system.",
