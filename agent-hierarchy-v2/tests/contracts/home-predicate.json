    {"id": "home-unset-is-the-default", "ah_test": null, "ah_home": null, "ops": [{"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}], "expect": {"accepted": true, "home": "$ROOT/pw/.claude/ah2"}},
    {"id": "home-blank-is-the-default", "ah_test": null, "ah_home": "   ", "ops": [{"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}], "expect": {"accepted": true, "home": "$ROOT/pw/.claude/ah2"}},
    {"id": "home-names-the-default", "ah_test": null, "ah_home": "$ROOT/pw/.claude/ah2", "ops": [{"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}], "expect": {"accepted": true, "home": "$ROOT/pw/.claude/ah2"}},
    {"id": "home-names-the-default-through-dotdot", "ah_test": null, "ah_home": "$ROOT/pw/.claude/x/../ah2", "ops": [{"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}, {"op": "mkdir", "path": "$ROOT/pw/.claude/x"}], "expect": {"accepted": true, "home": "$ROOT/pw/.claude/ah2"}},
    {"id": "home-not-listed", "ah_test": null, "ah_home": "$OUT/other", "ops": [{"op": "mkdir", "path": "$OUT/other"}, {"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}], "expect": {"accepted": false, "reason": "AH_HOME is not the default home and is not trusted"}},
    {"id": "home-listed", "ah_test": null, "ah_home": "$OUT/other", "ops": [{"op": "mkdir", "path": "$OUT/other"}, {"op": "mkdir", "path": "$ROOT/pw/.claude/ah2"}, {"op": "chmod", "path": "$ROOT/pw/.claude/ah2", "mode": "0700"}, {"op": "write", "path": "$ROOT/pw/.claude/ah2/trusted-homes", "content": "$OUT/other\n"}, {"op": "chmod", "path": "$ROOT/pw/.claude/ah2/trusted-homes", "mode": "0600"}], "expect": {"accepted": true, "home": "$OUT/other"}},
