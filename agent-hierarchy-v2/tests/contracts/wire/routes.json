{
  "about": "The daemon's /v1 HTTP surface as data. `hidden` routes are the daemon's own control surface. A test asserts this lists exactly the routes the Node daemon answers. max_body_bytes is per route; the message-write ops move to 256 KiB with W2 (0100 A8).",
  "server": {
    "headers_timeout_ms": 40000,
    "request_timeout_ms": 60000,
    "keep_alive_timeout_ms": 5000,
    "socket_mode": "0600",
    "drain_hard_ms": 5000,
    "error_413": {
      "connection": "close",
      "discard_max_bytes": 1048576,
      "discard_max_ms": 2000
    }
  },
