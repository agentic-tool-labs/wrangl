      "name": "cli-form-intake-usage",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<![A-Za-z0-9_./:-])ah issue-intake(?![A-Za-z0-9_-])",
      "groups": true,
      "replace": "node issue-intake.mjs",
      "example": {
        "in": "usage: ah issue-intake --cwd <abs> --out-dir <abs> (--issues <ref,ref,...> | --labelled)",
