      }
    },
    {
      "name": "usage-runtime-dir",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "the runtime dir \\(the hierarchy directory\\);",
      "replace": "the runtime dir via lib-hier.mjs;",
      "example": {
        "in": "resolves\\nthe runtime dir (the hierarchy directory); output is JSON",
        "out": "resolves\\nthe runtime dir via lib-hier.mjs; output is JSON"
      },
      "counterexample": {
        "in": "the runtime dir (the hierarchy directory) and more, the runtime dir via lib"
      }
