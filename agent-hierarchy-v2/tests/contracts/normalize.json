        "path": "proj/.claude/ah2/peers.jsonl"
      }
    },
    {
      "name": "cli-form-path-quoted",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(\\\\?\")([^\"\\'`\\\\]*)/bin/ah\\1 (roster|msg|gate)(?![A-Za-z0-9_])",
      "groups": true,
      "replace": "node $1$2/hooks/$3.mjs$1",
      "example": {
        "in": "run \"<PLUGIN>/bin/ah\" msg new, \"/x y/bin/ah\" roster teams, and JSON \\\"<PLUGIN>/bin/ah\\\" gate status",
        "out": "run node \"<PLUGIN>/hooks/msg.mjs\" new, node \"/x y/hooks/roster.mjs\" teams, and JSON node \\\"<PLUGIN>/hooks/gate.mjs\\\" status"
      },
      "counterexample": {
        "in": "\"<PLUGIN>/bin/ah\" hook x, \"<PLUGIN>/bin/ahx\" roster, \"<PLUGIN>/bin/ah\" rosters, \"<PLUGIN>/bin/ah\"roster, \"<PLUGIN>/bin/ah' roster"
      }
    },
    {
      "name": "cli-form-path-bare",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "([^ \\t\\r\\n\"\\'`(\\\\]*)/bin/ah (roster|msg|gate)(?![A-Za-z0-9_])",
      "groups": true,
      "replace": "node $1/hooks/$2.mjs",
      "example": {
        "in": "run <PLUGIN>/bin/ah roster teams, `/x/bin/ah msg new` and /h/été/bin/ah gate status",
        "out": "run node <PLUGIN>/hooks/roster.mjs teams, `node /x/hooks/msg.mjs new` and node /h/été/hooks/gate.mjs status"
      },
      "counterexample": {
        "in": "<PLUGIN>/bin/ah hook x, <PLUGIN>/bin/ahx roster, <PLUGIN>/bin/ah rosters, sbin/ah roster"
      }
    },
    {
      "name": "cli-form-ahd-path-quoted",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(\\\\?\")([^\"\\'`\\\\]*)/bin/ahd\\1(?![A-Za-z0-9_.-])",
      "groups": true,
      "replace": "node $1$2/hooks/ahd-ctl.mjs$1",
      "example": {
        "in": "run \"<PLUGIN>/bin/ahd\" logs, \"/x y/bin/ahd\" status, and JSON \\\"<PLUGIN>/bin/ahd\\\" check",
        "out": "run node \"<PLUGIN>/hooks/ahd-ctl.mjs\" logs, node \"/x y/hooks/ahd-ctl.mjs\" status, and JSON node \\\"<PLUGIN>/hooks/ahd-ctl.mjs\\\" check"
      },
      "counterexample": {
        "in": "\"<PLUGIN>/bin/ahdx\" status, \"<PLUGIN>/bin/ahd.pid\", \"<PLUGIN>/bin/ahd-tui\" --once"
      }
    },
    {
      "name": "cli-form-ahd-path-bare",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "([^ \\t\\r\\n\"\\'`(\\\\]*)/bin/ahd(?![A-Za-z0-9_.-])",
      "groups": true,
      "replace": "node $1/hooks/ahd-ctl.mjs",
      "example": {
        "in": "run <PLUGIN>/bin/ahd status and /h/été/bin/ahd logs",
        "out": "run node <PLUGIN>/hooks/ahd-ctl.mjs status and node /h/été/hooks/ahd-ctl.mjs logs"
      },
      "counterexample": {
        "in": "<PLUGIN>/bin/ahdx status, <PLUGIN>/bin/ahd.pid, <PLUGIN>/bin/ahd-tui, sbin/ahd status"
      }
    },
    {
      "name": "cli-form-bin",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<![A-Za-z0-9_./-])bin/ah (roster|msg|gate)(?![A-Za-z0-9_])",
      "groups": true,
      "replace": "hooks/$1.mjs",
      "example": {
        "in": "operations on `bin/ah roster` and bin/ah msg",
        "out": "operations on `hooks/roster.mjs` and hooks/msg.mjs"
      },
      "counterexample": {
        "in": "sbin/ah roster, bin/ah rosters, xbin/ah msg"
