    {
      "name": "cli-form-docs-path",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<=\\(verbs: )(?:/|<PLUGIN>)[^)\\n]*?(?=/docs/cli-tools\\.md\\))",
      "groups": true,
      "replace": "agent-hierarchy",
      "example": {
        "in": "ah CLI root (v1.2.3): /x/agent-hierarchy-v2 (verbs: /x/agent-hierarchy-v2/docs/cli-tools.md)",
