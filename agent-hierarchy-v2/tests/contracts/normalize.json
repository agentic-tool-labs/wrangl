    },
    {
      "name": "cli-form-ahd-bin",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<![A-Za-z0-9_./-])bin/ahd(?![A-Za-z0-9_.-])",
      "groups": true,
      "replace": "hooks/ahd-ctl.mjs",
      "example": {
        "in": "aliases of bin/ahd, which also inspects",
        "out": "aliases of hooks/ahd-ctl.mjs, which also inspects"
      },
      "counterexample": {
        "in": "sbin/ahd, bin/ahdx, bin/ahd.pid"
      }
    },
    {
      "name": "cli-form-name",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<![A-Za-z0-9_./:-])ah (roster|msg)(?![A-Za-z0-9_-])",
      "groups": true,
      "replace": "$1.mjs",
      "example": {
        "in": "Modelled on ah msg; run `ah roster init` first; ah rosteré and ah msgé",
        "out": "Modelled on msg.mjs; run `roster.mjs init` first; roster.mjsé and msg.mjsé"
