    {
      "name": "hook-error-unit",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(hook\\\\?\":\\\\?\")([a-z0-9-]+)(\\\\?\")",
      "groups": true,
      "replace": "$1$2.mjs$3",
      "example": {
        "in": "{\"hook\":\"stop\",\"message\":\"m\"} and {\\\"hook\\\":\\\"pretooluse-x\\\"}",
        "out": "{\"hook\":\"stop.mjs\",\"message\":\"m\"} and {\\\"hook\\\":\\\"pretooluse-x.mjs\\\"}"
      },
      "counterexample": {
        "in": "{\"hook\":\"stop.mjs\"}, {\"hookname\":\"stop\"}, {\"hook\":\"a b\"}, {\"hook\":\"Upper\"}"
      }
    },
    {
      "name": "usage-header-time",
      "applies_to": [
        "stdout"
      ],
      "pattern": "(?<=usage — )\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d",
      "replace": "<TS:usage>",
      "example": {
        "in": "agent-hierarchy usage — 2026-10-12 07:10",
        "out": "agent-hierarchy usage — <TS:usage>"
      },
      "counterexample": {
        "in": "usage — now, and on 2026-10-12 07:10"
      }
    },
    {
      "name": "sha256-json",
      "applies_to": [
        "stdout",
        "file"
      ],
      "keys": [
        "sha256"
      ],
      "value_pattern": "[0-9a-f]{64}",
      "replace": "\"<SHA256>\"",
      "example": {
        "in": "{\"snapshot\":\"x.md\",\"sha256\":\"abababababababababababababababababababababababababababababababab\"}",
        "out": "{\"snapshot\":\"x.md\",\"sha256\":\"<SHA256>\"}"
      },
      "counterexample": {
        "in": "{\"sha256\":\"abcd\"}"
      }
    },
    {
      "name": "git-base-json",
      "applies_to": [
        "stdout",
        "file"
      ],
      "keys": [
        "base"
      ],
      "value_pattern": "[0-9a-f]{40}",
      "replace": "\"<GITSHA>\"",
      "example": {
        "in": "{\"event\":\"ref\",\"ref\":\"r\",\"base\":\"527a8d1e2cb846853dacad266b5aa8bc4306f90d\"}",
        "out": "{\"event\":\"ref\",\"ref\":\"r\",\"base\":\"<GITSHA>\"}"
      },
      "counterexample": {
        "in": "{\"base\":\"main\",\"sha\":\"527a8d1e2cb846853dacad266b5aa8bc4306f90d\"}"
      }
    }
  ]
