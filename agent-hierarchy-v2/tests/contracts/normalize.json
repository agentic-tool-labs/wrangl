      "name": "cli-form-gate-usage",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "^([ \\t]+)ah gate (?=(?:set|status|reset)(?![A-Za-z0-9_]))",
      "groups": true,
      "replace": "$1node gate.mjs ",
      "flags": "gm",
      "example": {
        "in": "usage:\n  ah gate set --session <id>\n  ah gate status",
        "out": "usage:\n  node gate.mjs set --session <id>\n  node gate.mjs status"
      },
      "counterexample": {
        "in": "ah gate is a command\n  ah gate other"
      }
    },
    {
      "name": "cli-form-ahd-contract",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(?<![A-Za-z0-9_./-])ahd (contract)(?![A-Za-z0-9_])",
      "groups": true,
      "replace": "node hooks/ahd-ctl.mjs $1",
      "example": {
        "in": "rendered by `ahd contract` and ahd contract --plain",
        "out": "rendered by `node hooks/ahd-ctl.mjs contract` and node hooks/ahd-ctl.mjs contract --plain"
      },
      "counterexample": {
        "in": "the ahd conformance check, ahd conform, an ahd-contract flag, ahd contracts, ahd contract_x"
