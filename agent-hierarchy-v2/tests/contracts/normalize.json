      }
    },
    {
      "name": "cli-form-ahd-usage",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "^([ \\t]+)ahd (?=(?:start|stop|restart|drain|status|health|version|logs|inspect|check|contract|tui|state)(?![A-Za-z0-9_]))",
      "groups": true,
      "replace": "$1ahd-ctl.mjs ",
      "flags": "gm",
      "example": {
        "in": "usage:\n  ahd start | stop | restart",
        "out": "usage:\n  ahd-ctl.mjs start | stop | restart"
      },
      "counterexample": {
        "in": "ahd status is up\n  ahd serve"
      }
    },
    {
      "name": "cli-form-ahd-reason",
      "applies_to": [
        "stdout",
        "stderr",
        "file"
      ],
      "pattern": "(plugin-shipped CLI [^ ]) ahd (?=(?:start|stop|restart|drain|status|health|version|logs|inspect|check|contract|tui|state)(?![A-Za-z0-9_]))",
      "groups": true,
      "replace": "$1 ahd-ctl.mjs ",
      "example": {
        "in": "ah: plugin-shipped CLI — ahd inspect",
        "out": "ah: plugin-shipped CLI — ahd-ctl.mjs inspect"
      },
      "counterexample": {
        "in": "ah: plugin-shipped CLI — ahd bogus, plugin-shipped CLI — ahdx status, ahd inspect"
