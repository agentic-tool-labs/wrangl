{
  "lib": "lib-config",
  "module": "hooks/lib-config.mjs",
  "fn": "readPackManifest",
  "cases": [
    {
      "id": "missing",
      "args": [
        "$ROOT/pk",
        "demo"
      ],
      "files": {
        "pk/readme": "x"
      },
      "expect": {
        "error": {
          "code": "pack-missing",
          "message": "no ah-roles.json in $ROOT/pk"
        },
        "warnings": [],
        "roles": {}
      }
    },
    {
      "id": "not-json",
      "args": [
        "$ROOT/pk",
        "demo"
      ],
      "files": {
        "pk/ah-roles.json": "{nope"
