{
  "lib": "lib-config",
  "module": "hooks/lib-config.mjs",
  "fn": "parseAgentFrontmatter",
  "cases": [
    {
      "id": "no-frontmatter",
      "args": [
        "just text\n"
      ],
      "expect": {
        "frontmatter": false,
        "name": null,
        "description": null,
        "model": null,
        "tools": null,
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "unterminated",
      "args": [
        "---\nname: a\n"
      ],
      "expect": {
        "frontmatter": false,
        "name": null,
        "description": null,
        "model": null,
        "tools": null,
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "basic",
      "args": [
        "---\nname: a\ndescription: Does things.\nmodel: opus\ntools: Read, Grep\n---\nbody\n"
      ],
      "expect": {
        "frontmatter": true,
        "name": "a",
        "description": "Does things.",
        "model": "opus",
        "tools": [
          "Read",
          "Grep"
        ],
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "crlf",
      "args": [
        "---\r\nname: a\r\ntools: Read\r\n---\r\n"
      ],
      "expect": {
        "frontmatter": true,
        "name": "a",
        "description": null,
        "model": null,
        "tools": [
          "Read"
        ],
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "flow-list",
      "args": [
        "---\nname: a\ntools: [Read, Grep]\n---\nbody\n"
      ],
      "expect": {
        "frontmatter": true,
        "name": "a",
        "description": null,
        "model": null,
        "tools": [
          "Read",
          "Grep"
        ],
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "flow-list-empty",
      "args": [
        "---\nname: a\ntools: []\n---\nbody\n"
      ],
      "expect": {
        "frontmatter": true,
        "name": "a",
        "description": null,
        "model": null,
        "tools": [],
        "disallowedTools": null,
        "parseErrors": []
      }
    },
    {
      "id": "flow-unterminated",
      "args": [
