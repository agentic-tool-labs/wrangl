    {
      "id": "default",
      "args": [
        "$ROOT/repo",
        {}
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "roster": "default",
        "key": null,
        "source": "default",
        "level": null,
        "path": null
      }
    },
