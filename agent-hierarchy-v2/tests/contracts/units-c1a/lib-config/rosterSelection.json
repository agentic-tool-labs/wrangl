        "key": null,
        "source": "default",
        "level": null,
        "path": null
      }
    },
    {
      "id": "flag",
      "args": [
        "$ROOT/repo",
        {
          "flag": "squad"
        }
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "expect": {
        "roster": "squad",
        "key": "squad",
        "source": "flag",
        "level": null,
        "path": null
      }
    },
    {
