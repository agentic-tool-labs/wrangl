{
  "lib": "lib-config",
  "module": "hooks/lib-config.mjs",
  "fn": "checkoutRoot",
  "cases": [
    {
      "id": "normal",
      "args": [
        "$ROOT/repo/src"
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n",
        "repo/src/x": "y"
      },
      "expect": "$ROOT/repo"
    },
    {
      "id": "worktree",
      "args": [
        "$ROOT/wt"
      ],
      "files": {
        "main/.git/HEAD": "x",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n"
      },
      "expect": "$ROOT/main"
    },
    {
      "id": "worktree-nested",
      "args": [
        "$ROOT/wt/sub"
      ],
      "files": {
        "main/.git/HEAD": "x",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.git": "gitdir: $ROOT/main/.git/worktrees/wt\n",
        "wt/sub/x": "y"
      },
      "expect": "$ROOT/main"
    },
    {
      "id": "no-git",
      "args": [
        "$ROOT/plain"
      ],
      "files": {
        "plain/x": "y"
      },
      "expect": null
    },
    {
      "id": "empty-cwd",
      "args": [
        ""
      ],
      "files": {
        "plain/x": "y"
      },
      "cwd": "plain",
      "expect": null
    },
    {
      "id": "null-cwd",
      "args": [
        null
      ],
      "files": {
        "repo/.git/HEAD": "ref: refs/heads/main\n"
      },
      "cwd": "repo",
      "expect": "$ROOT/repo"
    },
    {
      "id": "submodule",
      "args": [
        "$ROOT/sub"
      ],
      "files": {
        "sub/.git": "gitdir: $ROOT/super/.git/modules/sub\n",
        "super/.git/HEAD": "x"
      },
      "expect": "$ROOT/sub"
    },
    {
      "id": "bare-common-dir",
      "args": [
        "$ROOT/wt"
      ],
      "files": {
        "wt/.git": "gitdir: $ROOT/bare.git/worktrees/wt\n",
        "bare.git/worktrees/wt/commondir": "../..\n"
      },
      "expect": "$ROOT/wt"
    }
  ]
}
