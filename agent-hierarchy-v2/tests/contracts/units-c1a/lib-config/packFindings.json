{
  "lib": "lib-config",
  "module": "hooks/lib-config.mjs",
  "fn": "packFindings",
  "cases": [
    {
      "id": "ok-no-text",
      "args": [
        "r",
        {
          "status": "ok"
        },
        null
      ],
      "expect": []
    },
    {
      "id": "missing-via-roster",
      "args": [
        "r",
        {
          "status": "pack-missing",
          "from": "p@m:r",
          "message": "gone",
          "via": "roster:gf"
        },
        null
      ],
      "expect": [
        {
          "level": "error",
          "code": "pack-missing",
          "path": null,
          "field": null,
          "message": "r (from p@m:r): gone",
          "fix": [
            {
              "kind": "remove",
              "detail": "remove it from roster gf's packs, or reinstall the pack"
            }
          ]
        }
      ]
    },
    {
      "id": "ok-with-warnings",
      "args": [
        "r",
        {
          "status": "ok",
          "from": "p@m:r",
          "agentPath": "/x/a.md",
          "warnings": [
            "/x/a.md holds a hidden character (U+200B at line 1, column 2)"
          ]
        },
        null
      ],
      "expect": [
        {
          "level": "warn",
          "code": "pack-warning",
          "path": "/x/a.md",
          "field": null,
          "message": "r (from p@m:r): /x/a.md holds a hidden character (U+200B at line 1, column 2)",
          "fix": []
        }
      ]
    },
    {
      "id": "ambiguous",
      "args": [
        "r",
        {
          "status": "pack-ambiguous",
          "from": "p@m:r",
          "message": "two installs"
        },
        null
      ],
      "expect": [
        {
          "level": "error",
          "code": "pack-ambiguous",
          "path": null,
          "field": null,
          "message": "r (from p@m:r): two installs",
          "fix": [
            {
              "kind": "uninstall",
              "detail": "uninstall all but one install of the plugin"
            }
          ]
        }
      ]
    },
    {
      "id": "other-status",
      "args": [
        "r",
        {
          "status": "pack-missing",
          "from": "p@m:r",
          "message": "gone",
          "subcode": "pack-missing"
        },
        null
      ],
      "expect": [
        {
          "level": "error",
          "code": "pack-missing",
          "path": null,
          "field": null,
          "message": "r (from p@m:r): gone",
          "fix": [
            {
              "kind": "remove",
              "detail": "`roster.mjs role remove r`, or reinstall the pack"
            }
          ]
        }
      ]
    },
    {
      "id": "with-text",
      "args": [
        "r",
        {
          "status": "ok",
          "agentText": "---\nname: a\n---\nbody\n",
          "agentPath": "/x"
        },
        null
      ],
      "expect": [
        {
          "level": "error",
          "code": "pack-agent-tools",
          "path": "/x",
          "field": null,
          "message": "tools is required: without it the agent inherits every tool, MCP tools and Agent included",
          "fix": [
            {
              "kind": "edit-frontmatter",
              "detail": "a pack agent's frontmatter may hold only name, description, model, tools, disallowedTools, color, effort, maxTurns, as plain unquoted keys"
            }
          ]
        }
      ]
    },
    {
      "id": "with-parsed",
      "args": [
        "r",
        {
          "status": "ok",
          "agentText": "ignored"
        },
        {
          "findings": [
            {
              "level": "error",
              "code": "c",
              "path": null,
              "field": null,
              "message": "m",
              "fix": []
            }
          ],
          "fm": {}
        }
      ],
      "expect": [
        {
          "level": "error",
          "code": "c",
          "path": null,
          "field": null,
          "message": "m",
          "fix": []
        }
      ]
    }
  ]
}
