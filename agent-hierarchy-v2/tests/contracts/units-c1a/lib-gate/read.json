      }
    },
    {
      "id": "newer",
      "args": [
        {}
      ],
      "files": {
        "home/.claude/agent-hierarchy.gate.json": "{\n  \"version\": 2,\n  \"sessions\": {\n    \"s1\": {}\n  }\n}\n"
      },
      "expect": {
        "version": 1,
        "sessions": {}
      }
    }
  ]
}
