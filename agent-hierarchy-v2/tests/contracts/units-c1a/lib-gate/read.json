      "args": [
        {}
      ],
      "expect": {
        "version": 1,
        "sessions": {}
      }
    },
    {
      "id": "present",
      "args": [
        {}
      ],
      "files": {
        "home/.claude/agent-hierarchy.gate.json": "{\n  \"version\": 1,\n  \"sessions\": {\n    \"s1\": {\n      \"choice\": \"each\",\n      \"at\": \"t\"\n    }\n  }\n}\n"
