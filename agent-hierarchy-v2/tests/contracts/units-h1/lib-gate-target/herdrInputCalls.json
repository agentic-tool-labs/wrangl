{
  "lib": "lib-gate-target",
  "module": "hooks/lib-gate-target.mjs",
  "fn": "herdrInputCalls",
  "cases": [
    {
      "id": "agent-prompt",
      "args": [
        "herdr agent prompt worker hello"
      ],
      "expect": [
        {
          "group": "agent",
          "verb": "prompt",
          "name": "worker",
          "pane": null,
          "args": [
            "hello"
          ]
        }
      ]
    },
    {
      "id": "agent-prompt-pane-flag",
      "args": [
        "herdr agent prompt worker --pane p_1 hello"
      ],
      "expect": [
        {
          "group": "agent",
          "verb": "prompt",
          "name": "worker",
          "pane": "p_1",
          "args": [
            "hello"
          ]
        }
      ]
    },
    {
      "id": "agent-prompt-pane-eq",
      "args": [
        "herdr agent prompt worker --pane=p_1 hello"
      ],
      "expect": [
        {
          "group": "agent",
          "verb": "prompt",
          "name": "worker",
          "pane": "p_1",
          "args": [
            "hello"
          ]
        }
      ]
    },
